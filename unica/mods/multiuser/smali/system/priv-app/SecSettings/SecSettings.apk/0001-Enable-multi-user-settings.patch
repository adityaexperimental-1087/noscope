     <SecPreferenceCategory android:title="@string/user_list_me_title" android:key="user_list_me" android:order="8" settings:searchable="false" />
     <SecPreferenceCategory android:title="@string/user_list_other_title" android:key="user_list" android:order="10" settings:searchable="false" />
